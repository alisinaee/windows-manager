      "kind": "call"
    }
  ],
  "external": [
    {
      "id": "windowserver",
      "name": "macOS WindowServer / SkyLight"
    },
    {
      "id": "dock",
      "name": "Dock.app (Mission Control, Spaces)"
    },
    {
      "id": "target-apps",
      "name": "User apps (Chrome, Telegram, VS Code, ...)"
    }
  ],
  "deployment": {
    "nodes": [
      {
        "id": "mac",
        "label": "User's Mac",
        "sub": "Menu bar app, Developer ID signed and notarized, macOS 26+",
        "kind": "device",
        "group": "dev"
      }
    ]
  },
  "containers": [
    {
      "id": "app",
      "name": "Windows Manager.app",
      "tech": "Swift 6, SwiftUI + AppKit, menu bar app",
      "components": [
        "menubar-ui",
        "settings-ui",
        "layout-editor",
        "onboarding",
        "intents",
        "hotkeys",
        "profile-engine",
        "restore-planner",
        "window-matcher",
        "display-map",
        "fullscreen-order",
        "space-guard",
        "pin-rules",
        "binding-repair",
        "layout-engine",
        "virtual-ws",
        "gestures",
        "content-restore",
        "ax-bridge",
        "window-list",
        "skylight-bridge",
        "mission-control",
        "app-launcher",
        "profile-store",
        "backup-store"
      ],
      "notes": "One process; private calls isolated in skylight-bridge."
    },
    {
      "id": "cli-bin",
      "name": "wmctl",
      "tech": "Swift command-line tool",
      "components": [
        "cli"
      ],
      "notes": "Talks to the running app."
    },
    {
      "id": "lab",
      "name": "SpacesLab",
      "tech": "Swift command-line tool",
      "components": [
        "spaces-lab"
      ],
      "notes": "Phase 1 experiments; results to docs/research."
    }
  ],
  "flows": [
    {
      "id": "one-click-restore",
      "name": "One-click restore",
      "notes": "Run a profile from the menu bar.",
      "steps": [
        {
          "from": "user",
          "to": "menubar-ui",
          "label": "Run Work"
        },
        {
          "from": "menubar-ui",
          "to": "profile-engine",
          "label": "run(profile)"
        },
        {
          "from": "profile-engine",
          "to": "restore-planner",
          "label": "diff live vs saved"
        },
        {
          "from": "profile-engine",
          "to": "app-launcher",
          "label": "open closed apps"
        },
        {
          "from": "profile-engine",
          "to": "ax-bridge",
          "label": "place windows"
        },
        {
          "from": "profile-engine",
          "to": "skylight-bridge",
          "label": "move to Desktops"
        },
        {
          "from": "profile-engine",
          "to": "fullscreen-order",
          "label": "full screen in saved order"
        }
      ]
    },
    {
      "id": "drift-fix",
      "name": "Space drift fix",
      "notes": "macOS reorders Spaces after sleep or a monitor change.",
      "steps": [
        {
          "from": "space-guard",
          "to": "skylight-bridge",
          "label": "read order"
        },
        {
          "from": "space-guard",
          "to": "menubar-ui",
          "label": "Order changed: Fix"
        },
        {
          "from": "space-guard",
          "to": "fullscreen-order",
          "label": "rebuild from first wrong slot"
        }
      ]
    }
  ]
}
